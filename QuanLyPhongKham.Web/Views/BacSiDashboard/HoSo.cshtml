@model QuanLyPhongKham.Models.DTOs.XemHoSoBacSiResponse


@{
    ViewData["Title"] = "Hồ sơ của tôi";
    Layout = "~/Views/Shared/_BacSiLayout.cshtml";
}

<div class="max-w-3xl mx-auto mt-6 bg-white rounded-xl shadow-lg overflow-hidden">

    <!-- HEADER -->
    <div class="bg-blue-600 px-6 py-4">
        <h2 class="text-white text-lg font-semibold">
            Hồ sơ cá nhân
        </h2>
    </div>

    <!-- BODY -->
    <div class="p-6 space-y-4">

        @if (TempData["Success"] != null)
        {
            <div class="bg-green-100 text-green-700 px-4 py-2 rounded">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="bg-red-100 text-red-700 px-4 py-2 rounded">
                @TempData["Error"]
            </div>
        }



        <form asp-action="CapNhatHoSo" asp-controller="BacSiDashboard" method="post" id="mainForm" class="space-y-4">


            @Html.AntiForgeryToken()

            <!-- Họ tên -->
            <div>


                <label class="block font-medium mb-1">
                    Họ tên <span class="text-red-500">*</span>
                </label>

                <input id="HoTen" type="text"
                       name="HoTen"
                       value="@Model?.HoTen"
                       class="w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" />

                <p id="errHoTen" class="hidden text-red-500 text-sm mt-1">
                    Vui lòng nhập họ tên
                </p>

            </div>

            <!-- Giới tính -->
            <div>

                <label class="block font-medium mb-1">
                    Giới tính <span class="text-red-500">*</span>
                </label>

                <select id="GioiTinh" name="GioiTinh"
                        class="w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400">
                    <option value="">-- Chọn --</option>

                    @if (Model?.GioiTinh == "Nam")
                    {
                        <option value="Nam" selected>Nam</option>
                    }
                    else
                    {
                        <option value="Nam">Nam</option>
                    }

                    @if (Model?.GioiTinh == "Nữ")
                    {
                        <option value="Nữ" selected>Nữ</option>
                    }
                    else
                    {
                        <option value="Nữ">Nữ</option>
                    }

                    @if (Model?.GioiTinh == "Khác")
                    {
                        <option value="Khác" selected>Khác</option>
                    }
                    else
                    {
                        <option value="Khác">Khác</option>
                    }
                </select>

                <p id="errGioiTinh" class="hidden text-red-500 text-sm mt-1">
                    Vui lòng chọn mục giới tính
                </p>
            </div>

            <!-- SĐT -->
            <div>
                <label class="block font-medium mb-1">
                    Số điện thoại <span class="text-red-500">*</span>
                </label>

                <input id="SoDienThoai" type="text"
                       name="SoDienThoai"
                       value="@Model?.SoDienThoai"
                       class="w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" />

                <p id="errSoDienThoai" class="hidden text-red-500 text-sm mt-1">
                    Vui lòng nhập số điện thoại
                </p>
            </div>
            <!-- Địa chỉ -->
            <div>
                <label class="block font-medium mb-1">
                    Địa chỉ <span class="text-red-500">*</span>
                </label>

                <textarea id="DiaChi" name="DiaChi"
                          rows="3"
                          class="w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400">@Model?.DiaChi</textarea>

                <p id="errDiaChi" class="hidden text-red-500 text-sm mt-1">
                    Vui lòng nhập địa chỉ
                </p>
            </div>

            <!-- Chuyên khoa -->
            <div>
                <label class="block font-medium mb-1">
                    Chuyên khoa <span class="text-red-500">*</span>
                </label>

                <select id="ChuyenKhoaId" name="ChuyenKhoaId"
                        class="w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400">
                    <option value="">-- Chọn chuyên khoa --</option>

                    @foreach (var ck in ViewBag.DanhSachChuyenKhoa)
                    {
                        if (Model?.ChuyenKhoaId == ck.Id)
                        {
                            <option value="@ck.Id" selected>@ck.TenKhoa</option>
                        }
                        else
                        {
                            <option value="@ck.Id">@ck.TenKhoa</option>
                        }
                    }
                </select>

                <p id="errChuyenKhoa" class="hidden text-red-500 text-sm mt-1">
                    Vui lòng chọn chuyên khoa
                </p>
            </div>

            <!-- Button -->
            <div class="pt-2">

          
                <div class="pt-6 border-t border-slate-200">
                    <h3 class="text-amber-600 font-bold mb-4 flex items-center text-lg">
                        <i class="fas fa-key mr-2"></i> Đổi mật khẩu
                    </h3>

                    <div class="space-y-4">
                        <div class="grid grid-cols-1 md:grid-cols-3 items-center">
                            <label class="text-slate-500 font-medium mb-1 md:mb-0">Mật khẩu cũ</label>
                            <input type="password" name="MatKhauCu" placeholder="Mật khẩu cũ"
                                   class="md:col-span-2 w-full border border-slate-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-100 focus:border-amber-500 outline-none transition" />
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 items-center">
                            <label class="text-slate-500 font-medium mb-1 md:mb-0">Mật khẩu mới</label>
                            <input type="password" name="MatKhauMoi" placeholder="Mật khẩu mới"
                                   class="md:col-span-2 w-full border border-slate-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-100 focus:border-amber-500 outline-none transition" />
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 items-center">
                            <label class="text-slate-500 font-medium mb-1 md:mb-0">Xác nhận MK mới</label>
                            <input type="password" name="XacNhanMatKhauMoi" placeholder="Xác nhận mật khẩu"
                                   class="md:col-span-2 w-full border border-slate-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-100 focus:border-amber-500 outline-none transition" />
                        </div>
                    </div>
                </div>

                <div class="pt-6 border-t border-slate-100 flex flex-wrap gap-3 justify-end">
                    <a href="@Url.Action("ThongTinCaNhan", "BacSiDashboard")" class="px-5 py-2.5 bg-slate-100 text-slate-700 rounded-lg hover:bg-slate-200 transition font-medium flex items-center">
                        <i class="fas fa-times mr-2"></i> Quay lại
                    </a>

                    <button id="btnLuuThongTin" type="button"
                            onclick="luuThongTinBacSi()"
                            class="px-5 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium flex items-center shadow-sm">
                        <i class="fas fa-save mr-2"></i> Lưu thông tin
                    </button>

                    <button type="submit" formaction="@Url.Action("DoiMatKhau", "BacSiDashboard")" class="px-5 py-2.5 bg-amber-500 text-white rounded-lg hover:bg-amber-600 transition font-medium flex items-center shadow-sm">
                        <i class="fas fa-key mr-2"></i> Đổi mật khẩu
                    </button>
                </div>

            </form>
            <script>
                        function luuThongTinBacSi() {
                            let isValid = true;

                            const form = document.getElementById("mainForm");



                <label class="block font-medium mb-1">
                    Giới tính <span class="text-red-500">*</span>
                </label>

                <select id="GioiTinh" name="GioiTinh"
                        class="w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400">
                    <option value="">-- Chọn --</option>

                    @if (Model?.GioiTinh == "Nam")
                    {
                        <option value="Nam" selected>Nam</option>
                    }
                    else
                    {
                        <option value="Nam">Nam</option>
                    }

                    @if (Model?.GioiTinh == "Nữ")
                    {
                        <option value="Nữ" selected>Nữ</option>
                    }
                    else
                    {
                        <option value="Nữ">Nữ</option>
                    }

                    @if (Model?.GioiTinh == "Khác")
                    {
                        <option value="Khác" selected>Khác</option>
                    }
                    else
                    {
                        <option value="Khác">Khác</option>
                    }

                </select>

                <p id="errGioiTinh" class="hidden text-red-500 text-sm mt-1">
                    Vui lòng chọn mục giới tính
                </p>
            </div>

            <div>

                <label class="block font-medium mb-1">
                    Số điện thoại <span class="text-red-500">*</span>
                </label>

                <input id="SoDienThoai" type="text"
                       name="SoDienThoai"
                       value="@Model?.SoDienThoai"
                       class="w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" />

                <p id="errSoDienThoai" class="hidden text-red-500 text-sm mt-1">
                    Vui lòng nhập số điện thoại
                </p>
            </div>
            <!-- Địa chỉ -->
            <div>
                <label class="block font-medium mb-1">
                    Địa chỉ <span class="text-red-500">*</span>
                </label>

                <textarea id="DiaChi" name="DiaChi"
                          rows="3"
                          class="w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400">@Model?.DiaChi</textarea>

                <p id="errDiaChi" class="hidden text-red-500 text-sm mt-1">
                    Vui lòng nhập địa chỉ
                </p>

            </div>

            <div>

                <label class="block font-medium mb-1">
                    Chuyên khoa <span class="text-red-500">*</span>
                </label>

                <select id="ChuyenKhoaId" name="ChuyenKhoaId"
                        class="w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400">
                    <option value="">-- Chọn chuyên khoa --</option>

                    @foreach (var ck in ViewBag.DanhSachChuyenKhoa)
                    {
                        if (Model?.ChuyenKhoaId == ck.Id)
                        {
                            <option value="@ck.Id" selected>@ck.TenKhoa</option>
                        }
                        else
                        {
                            <option value="@ck.Id">@ck.TenKhoa</option>
                        }
                    }
                </select>

                <p id="errChuyenKhoa" class="hidden text-red-500 text-sm mt-1">
                    Vui lòng chọn chuyên khoa
                </p>
            </div>


          
            
                <div class="pt-6 border-t border-slate-200">
                    <h3 class="text-amber-600 font-bold mb-4 flex items-center text-lg">
                        <i class="fas fa-key mr-2"></i> Đổi mật khẩu
                    </h3>
                
                    <div class="space-y-4">
                        <div class="grid grid-cols-1 md:grid-cols-3 items-center">
                            <label class="text-slate-500 font-medium mb-1 md:mb-0">Mật khẩu cũ</label>
                            <input type="password" name="MatKhauCu" placeholder="Mật khẩu cũ"
                                   class="md:col-span-2 w-full border border-slate-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-100 focus:border-amber-500 outline-none transition" />
                        </div>
                    
                        <div class="grid grid-cols-1 md:grid-cols-3 items-center">
                            <label class="text-slate-500 font-medium mb-1 md:mb-0">Mật khẩu mới</label>
                            <input type="password" name="MatKhauMoi" placeholder="Mật khẩu mới"
                                   class="md:col-span-2 w-full border border-slate-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-100 focus:border-amber-500 outline-none transition" />
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 items-center">
                            <label class="text-slate-500 font-medium mb-1 md:mb-0">Xác nhận MK mới</label>
                            <input type="password" name="XacNhanMatKhauMoi" placeholder="Xác nhận mật khẩu"
                                   class="md:col-span-2 w-full border border-slate-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-amber-100 focus:border-amber-500 outline-none transition" />
                        </div>
                    </div>
                </div>

                <div class="pt-6 border-t border-slate-100 flex flex-wrap gap-3 justify-end">
                    <a href="@Url.Action("ThongTinCaNhan", "BacSiDashboard")" class="px-5 py-2.5 bg-slate-100 text-slate-700 rounded-lg hover:bg-slate-200 transition font-medium flex items-center">
                        <i class="fas fa-times mr-2"></i> Quay lại
                    </a>
                
                    <button id="btnLuuThongTin" type="button"
                            onclick="luuThongTinBacSi()"
                            class="px-5 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium flex items-center shadow-sm">
                        <i class="fas fa-save mr-2"></i> Lưu thông tin
                    </button>
                
                    <button type="submit" formaction="@Url.Action("DoiMatKhau", "BacSiDashboard")" class="px-5 py-2.5 bg-amber-500 text-white rounded-lg hover:bg-amber-600 transition font-medium flex items-center shadow-sm">
                        <i class="fas fa-key mr-2"></i> Đổi mật khẩu
                    </button>
                </div>

            </form>
            <script>
                        function luuThongTinBacSi() {
                            let isValid = true;


                            const form = document.getElementById("mainForm");


                            const hoTen = document.getElementById("HoTen");
                            const gioiTinh = document.getElementById("GioiTinh");
                            const soDienThoai = document.getElementById("SoDienThoai");
                            const diaChi = document.getElementById("DiaChi");
                            const chuyenKhoa = document.getElementById("ChuyenKhoaId");

                            const errHoTen = document.getElementById("errHoTen");
                            const errGioiTinh = document.getElementById("errGioiTinh");
                            const errSoDienThoai = document.getElementById("errSoDienThoai");
                            const errDiaChi = document.getElementById("errDiaChi");
                            const errChuyenKhoa = document.getElementById("errChuyenKhoa");

                            errHoTen.classList.add("hidden");
                            errGioiTinh.classList.add("hidden");
                            errSoDienThoai.classList.add("hidden");
                            errDiaChi.classList.add("hidden");
                            errChuyenKhoa.classList.add("hidden");

                            hoTen.classList.remove("border-red-500");
                            gioiTinh.classList.remove("border-red-500");
                            soDienThoai.classList.remove("border-red-500");
                            diaChi.classList.remove("border-red-500");
                            chuyenKhoa.classList.remove("border-red-500");

                            if (hoTen.value.trim() === "") {
                                errHoTen.classList.remove("hidden");
                                hoTen.classList.add("border-red-500");
                                isValid = false;
                            }

                            if (gioiTinh.value.trim() === "") {
                                errGioiTinh.classList.remove("hidden");
                                gioiTinh.classList.add("border-red-500");
                                isValid = false;
                            }

                            if (soDienThoai.value.trim() === "") {
                                errSoDienThoai.classList.remove("hidden");
                                soDienThoai.classList.add("border-red-500");
                                isValid = false;
                            }

                            if (diaChi.value.trim() === "") {
                                errDiaChi.classList.remove("hidden");
                                diaChi.classList.add("border-red-500");
                                isValid = false;
                            }

                            if (chuyenKhoa.value.trim() === "") {
                                errChuyenKhoa.classList.remove("hidden");
                                chuyenKhoa.classList.add("border-red-500");
                                isValid = false;
                            }

                            if (isValid) {
                                form.action = '@Url.Action("CapNhatHoSo", "BacSiDashboard")';
                                form.submit();
                            }
                        }
            </script>

        </div>
    </div>