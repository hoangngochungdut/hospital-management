
@model QuanLyPhongKham.Models.DTOs.XemHoSoBenhNhanResponse
@{
    ViewData["Title"] = "Hồ sơ của tôi";
    Layout = "~/Views/Shared/_BenhNhanLayout.cshtml";
}
<div class="max-w-3xl mx-auto mt-4 bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    
    <div class="bg-blue-600 px-6 py-4 flex items-center">
        <h2 class="text-lg font-bold text-white mb-0 flex items-center">
            <i class="fas fa-user-circle mr-2 text-xl"></i> Hồ sơ cá nhân
        </h2>
    </div>

    <div class="p-6">
        
        @if (TempData["Success"] != null)
        {
            <div class="mb-5 p-3 bg-green-50 text-green-700 rounded-lg border border-green-100 flex items-center text-sm font-medium">
                <i class="fas fa-check-circle mr-2 text-lg"></i> @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="mb-5 p-3 bg-red-50 text-red-700 rounded-lg border border-red-100 flex items-center text-sm font-medium">
                <i class="fas fa-exclamation-circle mr-2 text-lg"></i> @TempData["Error"]
            </div>
        }

        <form method="post" id="mainForm">
            @Html.AntiForgeryToken()

            <div class="space-y-4">
                <div>
                    <label class="block text-slate-700 font-bold mb-1.5">
                        Họ tên <span class="text-red-500">*</span>
                    </label>

                    <input id="HoTen" type="text" name="HoTen" value="@Model?.HoTen"
                           class="w-full border border-slate-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-100 focus:border-blue-500 outline-none transition" />

                    <p id="errHoTen" class="hidden text-red-500 text-sm mt-1">
                        Vui lòng nhập họ tên
                    </p>
                </div>

                <div>
                    <label class="block text-slate-700 font-bold mb-1.5">
                        Giới tính <span class="text-red-500">*</span>
                    </label>

                    <select id="GioiTinh" name="GioiTinh"
                            class="w-full border border-slate-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-100 focus:border-blue-500 outline-none transition bg-white">
                        <option value="">-- Chọn --</option>
                        @if (Model?.GioiTinh == "Nam")
                        {
                            <option value="Nam" selected>Nam</option>
                        }
                        else
                        {
                            <option value="Nam">Nam</option>
                        }
                        @if (Model?.GioiTinh == "Nữ")
                        {
                            <option value="Nữ" selected>Nữ</option>
                        }
                        else
                        {
                            <option value="Nữ">Nữ</option>
                        }
                        @if (Model?.GioiTinh == "Khác")
                        {
                            <option value="Khác" selected>Khác</option>
                        }
                        else
                        {
                            <option value="Khác">Khác</option>
                        }
                    </select>
                    <p id="errGioiTinh" class="hidden text-red-500 text-sm mt-1">
                        Vui lòng chọn mục giới tính
                    </p>
                </div>

                <div>
                    <label class="block text-slate-700 font-bold mb-1.5">
                        Số điện thoại <span class="text-red-500">*</span>
                    </label>

                    <input id="SoDienThoai" type="tel" name="SoDienThoai" value="@Model?.SoDienThoai" placeholder="0123456789"
                           class="w-full border border-slate-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-100 focus:border-blue-500 outline-none transition" />

                    <p id="errSoDienThoai" class="hidden text-red-500 text-sm mt-1">
                        Vui lòng nhập số điện thoại
                    </p>

                <div>
                        <label class="block text-slate-700 font-bold mb-1.5">
                            Địa chỉ <span class="text-red-500">*</span>
                        </label>

                        <textarea id="DiaChi" name="DiaChi" rows="3" placeholder="Nhập địa chỉ chi tiết"
                              class="w-full border border-slate-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-100 focus:border-blue-500 outline-none transition resize-none">@Model?.DiaChi</textarea>
                        <p id="errDiaChi" class="hidden text-red-500 text-sm mt-1">
                            Vui lòng nhập địa chỉ
                        </p>

                </div>
            </div>

            <div class="mt-8 pt-6 border-t border-slate-200">
                <h3 class="text-amber-600 font-bold mb-4 flex items-center text-lg">
                    <i class="fas fa-key mr-2"></i> Đổi mật khẩu
                </h3>
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-slate-700 font-bold mb-1.5">Mật khẩu cũ</label>
                        <input type="password" name="MatKhauCu" placeholder="Nhập mật khẩu hiện tại"
                               class="w-full border border-slate-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-amber-100 focus:border-amber-500 outline-none transition" />
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-slate-700 font-bold mb-1.5">Mật khẩu mới</label>
                            <input type="password" name="MatKhauMoi" placeholder="Nhập mật khẩu mới"
                                   class="w-full border border-slate-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-amber-100 focus:border-amber-500 outline-none transition" />
                        </div>
                        <div>
                            <label class="block text-slate-700 font-bold mb-1.5">Xác nhận mật khẩu mới</label>
                            <input type="password" name="XacNhanMatKhauMoi" placeholder="Nhập lại mật khẩu mới"
                                   class="w-full border border-slate-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-amber-100 focus:border-amber-500 outline-none transition" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-8 pt-6 border-t border-slate-200 flex flex-wrap gap-3 justify-end">
                    <a href="javascript:history.back()" class="px-5 py-2.5 bg-slate-100 text-slate-700 rounded-lg hover:bg-slate-200 transition font-medium flex items-center">
                    <i class="fas fa-arrow-left mr-2"></i> Quay lại
                </a>
                
                    <button id="btnLuuThongTin" type="submit"
                            formaction="@Url.Action("CapNhatHoSo", "BenhNhanDashboard")"
                            class="px-5 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium flex items-center shadow-sm">
                        <i class="fas fa-save mr-2"></i> Lưu thông tin
                    </button>

                    <button type="submit"
                            formaction="@Url.Action("DoiMatKhau", "BenhNhanDashboard")"
                            class="px-5 py-2.5 bg-amber-500 text-white rounded-lg hover:bg-amber-600 transition font-medium flex items-center shadow-sm">
                        <i class="fas fa-key mr-2"></i> Đổi mật khẩu
                    </button>
            </div>
            
        </form>
            @section Scripts {
                <script>
                            document.getElementById("mainForm").addEventListener("submit", function (e) {
                                const button = e.submitter;

                                if (!button || button.id !== "btnLuuThongTin") {
                                    return;
                                }

                                let isValid = true;

                            const hoTen = document.getElementById("HoTen");
                            const gioiTinh = document.getElementById("GioiTinh");
                            const soDienThoai = document.getElementById("SoDienThoai");
                            const diaChi = document.getElementById("DiaChi");
                            const errHoTen = document.getElementById("errHoTen");
                            const errGioiTinh = document.getElementById("errGioiTinh");
                            const errSoDienThoai = document.getElementById("errSoDienThoai");
                            const errDiaChi = document.getElementById("errDiaChi");

                            errHoTen.classList.add("hidden");
                            errGioiTinh.classList.add("hidden");
                            errSoDienThoai.classList.add("hidden");
                            errDiaChi.classList.add("hidden");
                            hoTen.classList.remove("border-red-500");
                                gioiTinh.classList.remove("border-red-500");
                                soDienThoai.classList.remove("border-red-500");
                                diaChi.classList.remove("border-red-500");
                                                            if (hoTen.value.trim() === "") {
                                errHoTen.classList.remove("hidden");
                                hoTen.classList.add("border-red-500");
                                isValid = false;
                            }

                                if (gioiTinh.value.trim() === "") {
                                    errGioiTinh.classList.remove("hidden");
                                    gioiTinh.classList.add("border-red-500");
                                    isValid = false;
                                }

                                if (soDienThoai.value.trim() === "") {
                                    errSoDienThoai.classList.remove("hidden");
                                    soDienThoai.classList.add("border-red-500");
                                    isValid = false;
                                }

                                if (diaChi.value.trim() === "") {
                                    errDiaChi.classList.remove("hidden");
                                    diaChi.classList.add("border-red-500");
                                    isValid = false;
                                }

                                if (!isValid) {
                                    e.preventDefault();
                                }
                            });
                </script>
            }
    </div>
</div>